# provide some basic operators like matrix multiplication
import numpy as np

# base class
class Module:
    @property
    def params(self): # trainable parameters
        return []

    def __call__(self, *args, **kwargs):
        return self.forward( *args, **kwargs)

# sequential module
class Sequential(Module, list):
    def __init__(self, *module_lst):
        super().__init__(module_lst)
    
    @property
    def params(self):
        return sum([m.params for m in self], []) # concat all params
    
    def forward(self, x):
        y = x
        for module in self:
            #print(module)
            y = module(y)
        return y
    
    def backward(self, dy):
        dx = dy
        for module in self[::-1]:
            dx = module.backward(dx)
        return dx

class Sigmoid(Module):
    def __init__(self):
        super().__init__()
    
    def forward(self, x):
        self.sig = 1 / (1 + np.exp(-x))
        return self.sig
    
    def backward(self, dy):
        return dy * self.sig * (1 - self.sig)

class LeakyReLU(Module):
    def __init__(self, alpha=0.01):
        super().__init__()
        assert alpha >= 0, "Alpha should be non-negative"
        self.alpha = alpha
    
    def forward(self, x):
        self.cache = x  
        return np.where(x > 0, x, self.alpha * x)
    
    def backward(self, dy):
        dx = np.ones_like(self.cache)
        dx[self.cache <= 0] = self.alpha
        return dy * dx

class Linear(Module):
    def __init__(self, in_features, out_features):
        super().__init__()
        self.weight = (np.random.rand(out_features, in_features) * 2 - 1) / in_features ** 0.5
        self.bias = np.zeros(out_features)
        self.weight_grad = np.zeros_like(self.weight)
        self.bias_grad = np.zeros_like(self.bias)

    @property
    def params(self):
        return [dict(val=self.weight, grad=self.weight_grad),
                dict(val=self.bias, grad=self.bias_grad)]

    def forward(self, x):
        self.x = x
        return x @ self.weight.T + self.bias

    def backward(self, dy):
        self.weight_grad[:] = dy.T @ self.x
        self.bias_grad[:] = np.sum(dy, axis=0)
        return dy @ self.weight

class Conv2d(Module):
    def __init__(self, in_channels, out_channels, kernel_size, stride=1, padding=0):
        super().__init__()
        self.in_channels = in_channels
        self.out_channels = out_channels
        self.kernel_size = kernel_size
        self.stride = stride
        self.padding = padding
        
        self.weight = np.random.randn(out_channels, in_channels, kernel_size, kernel_size) * np.sqrt(2. / (in_channels * kernel_size * kernel_size))
        self.bias = np.zeros(out_channels)
        
        self.weight_grad = np.zeros_like(self.weight)
        self.bias_grad = np.zeros_like(self.bias)

    @property
    def params(self):
        return [dict(val=self.weight, grad=self.weight_grad), dict(val=self.bias, grad=self.bias_grad)]

    def forward(self, x):
        self.x = np.pad(x, ((0, 0), (0, 0), (self.padding, self.padding), (self.padding, self.padding)), mode='constant', constant_values=0)
        
        batch_size, _, height, width = self.x.shape
        out_height = (height - self.kernel_size) // self.stride + 1
        out_width = (width - self.kernel_size) // self.stride + 1
        
        self.y = np.zeros((batch_size, self.out_channels, out_height, out_width))
        
        # convolution
        for i in range(out_height):
            for j in range(out_width):
                h_start = i * self.stride
                w_start = j * self.stride
                h_end = h_start + self.kernel_size
                w_end = w_start + self.kernel_size
                x_slice = self.x[:, :, h_start:h_end, w_start:w_end]
                for k in range(self.out_channels):
                    self.y[:, k, i, j] = np.sum(x_slice * self.weight[k, :, :, :], axis=(1, 2, 3)) + self.bias[k]
        
        #print(self.y)
        return self.y

    def backward(self, dy):
        # Initialize grad
        dx = np.zeros_like(self.x)
        self.weight_grad[:] = 0
        self.bias_grad[:] = 0
        
        # Compute grad
        batch_size, _, out_height, out_width = dy.shape
        for i in range(out_height):
            for j in range(out_width):
                h_start = i * self.stride
                w_start = j * self.stride
                h_end = h_start + self.kernel_size
                w_end = w_start + self.kernel_size
                for k in range(self.out_channels):
                    dx[:, :, h_start:h_end, w_start:w_end] += dy[:, k:k+1, i:i+1, j:j+1] * self.weight[k, :, :, :]
                    self.weight_grad[k, :, :, :] += np.sum(self.x[:, :, h_start:h_end, w_start:w_end] * dy[:, k:k+1, i:i+1, j:j+1], axis=0)
                self.bias_grad[k] += np.sum(dy[:, k, i, j])
        
        # remove padding
        dx = dx[:, :, self.padding:-self.padding, self.padding:-self.padding]
        return dx

class Dropout(Module):
    def __init__(self, p=0.5):
        super().__init__()
        self.p = p  
        self.mask = None

    def forward(self, x, training=True):
        if training:
            self.mask = (np.random.rand(*x.shape) < self.p) / self.p
            return x * self.mask  # 应用 mask
        else:
            return x

    def backward(self, dy):
        return dy * self.mask

class BatchNorm2d(Module):
    def __init__(self, num_features, eps=1e-5, momentum=0.1):
        super().__init__()
        self.num_features = num_features
        self.eps = eps
        self.momentum = momentum
        
        # 初始化可学习参数 gamma（缩放因子）和 beta（偏移因子）
        self.gamma = np.ones(num_features)
        self.beta = np.zeros(num_features)
        
        # 初始化用于跟踪特征的均值和方差的参数
        self.running_mean = np.zeros(num_features)
        self.running_var = np.ones(num_features)
        
        # 用于存储梯度的变量
        self.gamma_grad = np.zeros_like(self.gamma)
        self.beta_grad = np.zeros_like(self.beta)

    @property
    def params(self):
        return [dict(val=self.gamma, grad=self.gamma_grad), dict(val=self.beta, grad=self.beta_grad)]

    def forward(self, x, training=True):
        self.input_shape = x.shape 
        if training:
            batch_mean = np.mean(x, axis=(0, 2, 3), keepdims=True)
            batch_var = np.var(x, axis=(0, 2, 3), keepdims=True)
            
            self.running_mean = self.momentum * self.running_mean + (1 - self.momentum) * batch_mean.squeeze()
            self.running_var = self.momentum * self.running_var + (1 - self.momentum) * batch_var.squeeze()
            
            self.normalized = (x - batch_mean) / np.sqrt(batch_var + self.eps)
        else:
            self.normalized = (x - self.running_mean.reshape(1, -1, 1, 1)) / np.sqrt(self.running_var.reshape(1, -1, 1, 1) + self.eps)
        
        out = self.gamma.reshape(1, -1, 1, 1) * self.normalized + self.beta.reshape(1, -1, 1, 1)
        return out

    def backward(self, dy):
        self.gamma_grad = np.sum(dy * self.normalized, axis=(0, 2, 3))
        self.beta_grad = np.sum(dy, axis=(0, 2, 3))
        
        dx_norm = dy * self.gamma.reshape(1, -1, 1, 1)
        dx = (1. / np.sqrt(self.running_var + self.eps).reshape(1, -1, 1, 1)) * (dx_norm - np.mean(dx_norm, axis=(0, 2, 3), keepdims=True) - self.normalized * np.mean(dx_norm * self.normalized, axis=(0, 2, 3), keepdims=True))
        
        return dx.reshape(self.input_shape)

class AvgPool2d(Module):
    def __init__(self, kernel_size, stride=None, padding=0):
        super().__init__()
        self.kernel_size = kernel_size
        self.stride = stride if stride is not None else kernel_size
        self.padding = padding
    
    def forward(self, x):
        self.x = x
        n, c, h, w = x.shape
        h_out = (h - self.kernel_size + 2 * self.padding) // self.stride + 1
        w_out = (w - self.kernel_size + 2 * self.padding) // self.stride + 1
        
        x_padded = np.pad(x, ((0, 0), (0, 0), (self.padding, self.padding), (self.padding, self.padding)), mode='constant', constant_values=0)
        
        out = np.zeros((n, c, h_out, w_out))
        
        for i in range(h_out):
            for j in range(w_out):
                h_start = i * self.stride
                w_start = j * self.stride
                h_end = h_start + self.kernel_size
                w_end = w_start + self.kernel_size
                out[:, :, i, j] = np.mean(x_padded[:, :, h_start:h_end, w_start:w_end], axis=(2, 3))
                
        return out

    def backward(self, dy):
        n, c, h_out, w_out = dy.shape
        dx = np.zeros_like(self.x)
        
        for i in range(h_out):
            for j in range(w_out):
                h_start = i * self.stride
                w_start = j * self.stride
                h_end = h_start + self.kernel_size
                w_end = w_start + self.kernel_size
                dx[:, :, h_start:h_end, w_start:w_end] += (dy[:, :, i:i+1, j:j+1] / (self.kernel_size * self.kernel_size))
        
        return dx

class Flatten(Module):
    def __init__(self):
        super().__init__()

    def forward(self, x):
        self.original_shape = x.shape 
        return x.reshape(x.shape[0], -1)  

    def backward(self, dy):
        return dy.reshape(self.original_shape)

